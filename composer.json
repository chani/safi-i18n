{
    "name": "chani/safi-i18n",
    "description": "Fast, secure-by-design JSON & Source-Key i18n extension with OPcache compilation for Safi Microframework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jean Bruenn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "chani/safi-core": "^0.1.0"
    },
    "suggest": {
        "chani/safi-view-twig": "Required to enable Twig translation filters and functions (^0.1.0)."
    },
    "require-dev": {
        "chani/safi-view-twig": "^0.1.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "twig/twig": "^3.15",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Safi\\Extensions\\I18n\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Safi\\Extensions\\I18n\\Tests\\": "tests/",
            "Safi\\Core\\": "../safi-core/src/",
            "Safi\\Extensions\\ViewTwig\\": "../safi-view-twig/src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../safi-*"
        },
        {
            "type": "path",
            "url": "../wajha-router"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
